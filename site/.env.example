# Banco de dados (Vercel Postgres ou Neon — string de conexão padrão Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Vercel Blob — necessário só para rodar scripts/sync-to-blob.ts com --write
# (crie um Blob store no dashboard da Vercel e copie o token gerado)
BLOB_READ_WRITE_TOKEN=""

# Google Drive (opcional, somente leitura) — usado por src/lib/google-drive.ts
# caso o Drive precise ser lido diretamente no futuro. Hoje a fonte usada pelo
# sync é a cópia local em lumeducacao/, então estas variáveis não são
# obrigatórias.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_DRIVE_FOLDER_ID=""

# As próximas etapas do projeto vão adicionar aqui:
# - NEXTAUTH_URL / NEXTAUTH_SECRET (ou variáveis do Clerk)
# - STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET
# - MERCADOPAGO_ACCESS_TOKEN / MERCADOPAGO_WEBHOOK_SECRET
# - GITHUB_TOKEN (para leitura do repositório de materiais, se privado)
